# ==============================================================================
# Ghostwriter AI - Backend Environment Configuration
# ==============================================================================

# Google AI Studio API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Open-weight Gemma model identifier accessible via Gemini API
# Supported options include:
#   - gemma-2-9b-it   (Recommended: balanced speed and high narrative prose quality)
#   - gemma-2-27b-it  (High literary quality)
GEMMA_MODEL_ID=gemma-2-9b-it

# Frontend Allowed Origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Environment (development | production)
ENVIRONMENT=development
